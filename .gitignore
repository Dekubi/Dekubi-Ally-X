# ---------------------------------------------------------------------------
# Rule 1: nothing from a game, console SDK or other proprietary source is
# ever committed. Keep game folders, dumps and caches outside the repo.
# CI (`asset policy` step) is the second check.
# Patterns adapted from VIctory (Marvisak, GPL-3.0-or-later).
# ---------------------------------------------------------------------------

# Build output
/target/
debug/
**/*.rs.bk
**/mutants.out*/
rustc-ice-*.txt

# Places people drop data into
/game/
/games/
/data/
/dump/
/dumps/
/extracted/
/cache/
/out/

# Executables, libraries, symbols
*.exe
*.dll
*.pdb
*.lib
*.sys
*.obj
*.exp
*.ilk

# Console packages and containers
*.xvd
*.xvc
*.msixvc
*.xsp
*.cab
*.msi
*.alignmentchunk

# Typical game data
*.bin
# The one exception: the BCPack format's constant tables (see victory-fork docs/asset-policy.md).
!/crates/ally-formats/src/bcpack-tables.bin
*.dat
*.pak
*.rpf
*.ttpf
*.dds
*.ktx
*.ktx2
*.dxbc
*.dxil
*.cso
*.spv
*.wav
*.xma
*.ogg
*.opus
*.mp3
*.mp4
*.bik
*.bk2
*.awc
*.zip
*.7z
*.rar

# Logs
*.log
crashes.log

# Editor / OS noise
.vs/
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Claude session scratch (completions/sessions are committed, active is not)
.claude/sessions/active/*
!.claude/sessions/active/.gitkeep
.claude/settings.local.json
